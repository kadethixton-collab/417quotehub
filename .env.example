# Where homeowner quote requests are POSTed as JSON.
# Comma-separate several to send each lead to all of them, e.g. your Google Sheet + a Zapier hook:
#   LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXX/exec?key=SECRET,https://hooks.zapier.com/hooks/catch/YYY
# Leave blank during development: leads will be printed to the server console instead.
LEAD_WEBHOOK_URL=

# Optional: separate webhook(s) for contractor "Partner With Us" applications.
# Falls back to LEAD_WEBHOOK_URL when blank.
PARTNER_WEBHOOK_URL=

# Canonical production URL used for SEO tags, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://417quotehub.com

# Optional: enables photo upload on the quote form. Create a Blob store in Vercel
# (Storage → Blob → Connect to project) and this is added for you. Redeploy afterwards.
BLOB_READ_WRITE_TOKEN=

# Optional: Google Analytics 4 measurement ID (e.g. G-ABC123XYZ).
NEXT_PUBLIC_GA_ID=
