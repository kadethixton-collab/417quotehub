# Where homeowner quote requests are POSTed as JSON (Zapier, Make, n8n, Slack, your CRM...).
# Leave blank during development: leads will be printed to the server console instead.
LEAD_WEBHOOK_URL=

# Optional: separate webhook for contractor "Partner With Us" applications.
# Falls back to LEAD_WEBHOOK_URL when blank.
PARTNER_WEBHOOK_URL=

# Optional: canonical production URL used for SEO tags, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://417quotehub.com
